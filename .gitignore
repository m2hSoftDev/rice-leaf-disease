# Python virtual environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Data directories and datasets (not committed to git per Section 12)
data/raw/
data/processed/
data/**/*.csv
data/*.csv
data/**/*.zip
data/**/*.tar.gz
*.zip
*.tar.gz
!data/**/.gitkeep
!data/metadata/.gitkeep

# Models and exported weights
*.keras
*.h5
*.tflite

# Results artifacts and cache
results/figures/*
!results/figures/.gitkeep
results/metrics/*
!results/metrics/.gitkeep
results/failure_cases/*
!results/failure_cases/.gitkeep

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Flutter build artifacts
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
